{
  "version": "1.0.0",
  "payload_type": "python",
  "features": [
    "antidbg",
    "integrity",
    "encrypt",
    "memguard",
    "selfdestruct",
    "exec_guard"
  ],
  "build_seed": "",
  "encryption": {
    "algorithm": "aes-256-ctr",
    "key_derivation": "aes-256(seed) over the block counter, two 16-byte outputs concatenated (matches runtime/src/decrypt.rs derive_block_key)"
  },
  "integrity": {
    "algorithm": "crc32",
    "check_at": "startup"
  },
  "self_destruct": {
    "on_exit": true,
    "on_detach": true,
    "memory_scrub": true
  }
}
